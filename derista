manage_memory() {
  local memdir="$HOME/.claude/projects/-root/memory"
  mkdir -p "$memdir"
  while true; do
    mapfile -t mfiles < <(find "$memdir" -maxdepth 1 -name '*.md' ! -name 'MEMORY.md' -printf '%T@|%p\n' 2>/dev/null | sort -rn | cut -d'|' -f2-)
    local nmem=${#mfiles[@]}
    head2 "KELOLA MEMORI" "$nmem file tersimpan di memory/"
    local i=1 f title type size mtime sz_dot
    for f in "${mfiles[@]}"; do
      title="$(grep -m1 '^description:' "$f" 2>/dev/null | sed 's/^description:[[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//')"
      [ -z "$title" ] && title="$(basename "$f" .md)"
      type="$(grep -A2 '^metadata:' "$f" 2>/dev/null | grep -m1 '^[[:space:]]*type:' | sed 's/.*type:[[:space:]]*//')"
      [ -z "$type" ] && type="-"
      sz="$(stat -c %s "$f" 2>/dev/null || echo 0)"
      mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
      now="$(date +%s)"; (( now - mtime < 86400 )) && sz_dot="${G}●${N}" || sz_dot="${D}○${N}"
      printf '   %s%2d%s %s %-44s %s%-12s%s %s%5s%s %s\n' \
        "$G" "$i" "$N" "$sz_dot" \
        "$(printf '%s' "$title" | cut -c1-44)" \
        "$M" "$type" "$N" \
        "$D" "$(human_size "$sz")" "$N" \
        "$(ago "$mtime")"
      i=$((i+1))
    done
    sect "AKSI"
    printf '   %sa%s  tambah memori     %se%s  edit (buka di editor)\n' "$C" "$N" "$C" "$N"
    printf '   %sv%s  lihat isi         %sd%s  hapus memori\n' "$C" "$N" "$C" "$N"
    printf '   %sr%s  reindex MEMORY.md %s0%s  kembali\n' "$C" "$N" "$D" "$N"
    local c v k
    read -rp "  Pilih: " c || return
    case "$c" in
      0|x|X|'') return ;;
      a|A) add_memory ;;
      e|E)
        read -rp "  Edit memori nomor: " k
        if [[ "$k" =~ ^[0-9]+$ ]] && (( k>=1 && k<=nmem )); then edit_memory "${mfiles[k-1]}"
        else err "Nomor tidak valid."; pause; fi ;;
      v|V)
        read -rp "  Lihat memori nomor: " k
        if [[ "$k" =~ ^[0-9]+$ ]] && (( k>=1 && k<=nmem )); then view_memory "${mfiles[k-1]}"
        else err "Nomor tidak valid."; pause; fi ;;
      d|D)
        read -rp "  Hapus memori nomor: " k
        if [[ "$k" =~ ^[0-9]+$ ]] && (( k>=1 && k<=nmem )); then del_memory "${mfiles[k-1]}"
        else err "Nomor tidak valid."; pause; fi ;;
      r|R) reindex_memory; ok "MEMORY.md diperbarui."; pause ;;
      *) err "Pilihan tidak ada."; pause ;;
    esac
  done
}

view_memory() {
  local f="$1" memdir="$HOME/.claude/projects/-root/memory"
  [ -f "$f" ] || { warn "File tidak ada."; pause; return; }
  local title type
  title="$(grep -m1 '^description:' "$f" 2>/dev/null | sed 's/^description:[[:space:]]*//')"
  type="$(grep -A2 '^metadata:' "$f" 2>/dev/null | grep -m1 '^[[:space:]]*type:' | sed 's/.*type:[[:space:]]*//')"
  head2 "ISI MEMORI" "$(basename "$f") · $title · $type"
  cls
  printf '\n  %s%s%s\n' "$C$B" "$(basename "$f")" "$N"
  printf '  %sJudul:%s %s\n' "$D" "$N" "$title"
  printf '  %sTipe:%s  %s\n' "$D" "$N" "$type"
  rule
  local w; w=$(( $(cols) - 4 )); [ "$w" -lt 40 ] && w=40
  head -200 "$f" | cut -c1-"$w"
  echo; rule
  local lines; lines="$(wc -l < "$f")"
  printf '  %s%d baris%s\n\n' "$D" "$lines" "$N"
  pause
}

edit_memory() {
  local f="$1"
  [ -f "$f" ] || { warn "File tidak ada."; pause; return; }
  local editor="${EDITOR:-nano}"
  command -v "$editor" >/dev/null 2>&1 || editor="nano"
  command -v "$editor" >/dev/null 2>&1 || editor="vi"
  printf '  %sBuka %s di %s...%s\n' "$D" "$f" "$editor" "$N"
  sleep 1
  cls
  "$editor" "$f"
  ok "Selesai edit."; pause
}

del_memory() {
  local f="$1" memdir="$HOME/.claude/projects/-root/memory" idx="$memdir/MEMORY.md"
  [ -f "$f" ] || { warn "File tidak ada."; pause; return; }
  local title slug yn
  title="$(grep -m1 '^description:' "$f" 2>/dev/null | sed 's/^description:[[:space:]]*//')"
  slug="$(basename "$f" .md)"
  head2 "HAPUS MEMORI"
  printf '  %s%s%s\n' "$B" "$title" "$N"
  printf '  %s%s%s\n\n' "$D" "$f" "$N"
  read -rp "  Yakin hapus '$title'? (y/N): " yn || return
  [[ "$yn" =~ ^[Yy]$ ]] || { warn "Dibatalkan."; pause; return; }
  rm -f "$f" && ok "File dihapus." || { err "Gagal hapus."; pause; return; }
  if [ -f "$idx" ]; then
    local tmp; tmp="$(mktemp)"
    grep -v -F "[$title]($slug.md)" "$idx" > "$tmp" 2>/dev/null && mv "$tmp" "$idx"
    rm -f "$tmp"
    ok "Entry di MEMORY.md ikut dibersihkan."
  fi
  pause
}

reindex_memory() {
  local memdir="$HOME/.claude/projects/-root/memory" idx="$memdir/MEMORY.md"
  {
    echo "# Memory"
    echo
    for f in "$memdir"/*.md; do
      [ -f "$f" ] || continue
      [ "$(basename "$f")" = "MEMORY.md" ] && continue
      local title slug hook body
      title="$(grep -m1 '^description:' "$f" 2>/dev/null | sed 's/^description:[[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//')"
      [ -z "$title" ] && title="$(basename "$f" .md)"
      slug="$(basename "$f" .md)"
      hook="$(awk 'BEGIN{p=0} /^---$/{c++; next} c>=2{p=1} p{print; if(NR>80)exit}' "$f" | grep -v '^[[:space:]]*$' | head -1 | sed 's/^[[:space:]]*//')"
      [ -z "$hook" ] && hook="$(basename "$f" .md)"
      [ "${#hook}" -gt 80 ] && hook="${hook:0:77}..."
      printf -- '- [%s](%s.md) — %s\n' "$title" "$slug" "$hook"
    done
  } > "$idx"
}

add_memory() {
  head2 "TAMBAH MEMORI" "kosong + Enter = batal"
  local memdir="$HOME/.claude/projects/-root/memory"
  mkdir -p "$memdir"
  local title body type slug base file i=2 hook idx
  read -rp "  Judul singkat: " title || return
  [ -z "$title" ] && { warn "Dibatalkan."; pause; return; }
  read -rp "  Isi memori   : " body || return
  [ -z "$body" ] && { warn "Isi kosong, dibatalkan."; pause; return; }
  read -rp "  Tipe (user/feedback/project/reference) [project]: " type; type="${type:-project}"
  slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  [ -z "$slug" ] && slug="memori"
  base="$slug"; file="$memdir/$slug.md"
  while [ -e "$file" ]; do slug="$base-$i"; file="$memdir/$slug.md"; i=$((i+1)); done
  {
    echo "---"
    echo "name: $slug"
    echo "description: $title"
    echo "metadata:"
    echo "  type: $type"
    echo "---"
    echo
    echo "$body"
  } > "$file"
  reindex_memory
  ok "Memori '$title' disimpan."
  printf '  %s%s%s\n' "$D" "$file" "$N"; pause
}

chat_active() {
  local f now mt c=0
  now="$(date +%s)"
  while IFS= read -r f; do
    mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
    (( now - mt < 45 )) && c=$((c+1))
  done < <(sess_files)
  printf '%s' "$c"
}

